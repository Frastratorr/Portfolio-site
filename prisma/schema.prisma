generator client {
  provider = "prisma-client"
  output   = "./app/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String
  description   String
  modelPath     String
  previewImage  String?
  gallery       String[]
  processImages String[]
  arLink        String?
  createdAt     DateTime @default(now())
}