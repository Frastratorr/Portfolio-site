generator client {
  provider = "prisma-client"
  output   = "../app/lib/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  title            String
  description      String
  modelPath        String
  previewImage     String?
  gallery          String[]
  processImages    String[]
  arLink           String?

  category         String   @default("Props")
  tags String[] @default([])
  isPublished Boolean @default(true)

  wireframeImage   String?
  finalRender      String?

  polygonCount     Int?
  triangleCount    Int?
  textureResolution String?
  softwareUsed     String[]
  modelingTime     String?

  createdAt        DateTime @default(now())
}