
generator client {
  provider = "prisma-client"
  output   = "../app/lib/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  title            String
  description      String
  modelPath        String
  previewImage     String?
  gallery          String[]
  processImages    String[]
  arLink           String?

  category         String   @default("Props")
  tags             String[] @default([])
  isPublished      Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  views            Int      @default(0)

  // SEO Settings
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String[] @default([])
  ogTitle          String?
  ogDescription    String?
  ogImage          String?
  canonicalUrl     String?

  wireframeImage   String?
  finalRender      String?

  polygonCount      Int?
  triangleCount     Int?
  textureResolution String?
  softwareUsed      String[]
  modelingTime      String?

  createdAt        DateTime @default(now())
}

model SiteSettings {
  id               Int      @id @default(1)

  // Global SEO
  siteTitle        String   @default("3D Artist Portfolio")
  siteDescription  String   @default("3D Artist Portfolio")
  siteKeywords     String[] @default([])
  siteUrl          String?
  defaultOgImage   String?

  updatedAt        DateTime @updatedAt
}
